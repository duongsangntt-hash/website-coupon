# dependencies
/node_modules

# next.js
/.next/
# NOTE: /out/ (the static export — plain HTML/CSS/JS, no Node.js server)
# is intentionally NOT ignored — it's committed pre-built. Shared-hosting
# process limits (CloudLinux LVE) can't run `next build`'s worker pool, so
# the build happens locally and the output is pushed as-is; the host just
# serves /out with Apache. See README "Deploy" section.

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/extensions.json

# Claude Code local session state
.claude/

# internal business data — not part of the deployed app
List Affiliate.xlsx
